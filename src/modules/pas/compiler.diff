+{$ifdef i386}
+  RegisterExternalLinker(system_i386_lost_info,TLinkerLost);
+  RegisterImport(system_i386_lost,timportliblost);
+  RegisterExport(system_i386_lost,texportliblost);
+  RegisterTarget(system_i386_lost_info);
+//  RegisterRes(res_elf32_info);
+{$endif i386}
+end.
